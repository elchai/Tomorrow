# TOMORROW scanner — copy to .env and fill in. NEVER commit .env.
# Telegram MTProto (user account, NOT a bot) — get from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=            # dedicated number, neutral profile
TELEGRAM_SESSION=         # filled automatically after `npm run auth`

# Firebase Realtime DB (where signals are written; the dashboard reads /crime-signals)
FIREBASE_URL=             # e.g. https://tomorrow-xxxx-rtdb.firebaseio.com
FIREBASE_DB_SECRET=       # optional legacy DB secret / token appended as ?auth=

# Tuning
SIGNAL_TTL_HOURS=72       # auto-expire old signals
MIN_CONFIDENCE=0.5        # drop classifications weaker than this
